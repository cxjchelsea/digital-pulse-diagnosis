      "observed_summary": {
        "n": 10,
        "min": 10.0,
        "max": 10.0,
        "mean": 10.0
      },
      "rationale": "beat_count < 4 with adequate duration → insufficient_beats."
    },
    {
      "parameter": "max_interval_cv",
      "value": 0.35,
      "parameter_class": "simulation_only",
      "observed_summary": {
        "n": 10,
        "min": 0.010340464581257107,
        "max": 0.018309245124894236,
        "mean": 0.014159788694827005
      },
      "rationale": "interval_cv >= max → unstable_intervals (algorithmic, not arrhythmia)."
    },
    {
      "parameter": "reference_min_lag_ms",
      "value": 20.0,
      "parameter_class": "simulation_only",
      "observed_summary": {
        "n": 10,
        "min": 72.0,
        "max": 76.0,
        "mean": 75.2
      },
      "rationale": "Minimum allowed PPG-pulse lag (lag = ppg - pulse). Observed normal≈72-80ms."
    },
    {
      "parameter": "reference_max_lag_ms",
      "value": 140.0,
      "parameter_class": "simulation_only",
      "observed_summary": {
        "n": 10,
        "min": 72.0,
        "max": 76.0,
        "mean": 75.2
      },
      "rationale": "Maximum lag for a valid match. normal≈72-80ms; misalignment≈220ms falls outside and reduces match_rate."
    },
    {
      "parameter": "min_ppg_match_rate",
      "value": 0.7,
      "parameter_class": "simulation_only",
      "observed_summary": {
        "n": 10,
        "min": 0.5,
        "max": 1.0,
        "mean": 0.75
      },
      "rationale": "match_rate < 0.7 → reference_mismatch when reference available."
    },
    {
      "parameter": "max_lag_mad_ms",
