{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adaptive-radial-pulse/m1-simulator-plan.schema.json",
  "title": "M1 Simulator Multi-Attempt Plan Artifact",
  "description": "Simulator plan.json for multi-attempt cases. Not an M1-P0 FileRole.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_version",
    "artifact_role",
    "plan_id",
    "plan_version",
    "case_id",
    "max_attempts",
    "attempt_count",
    "attempts",
    "expected_final_quality",
    "expected_final_action",
    "analysis_allowed",
    "expected_completion",
    "limitations"
  ],
  "properties": {
    "artifact_version": { "type": "string", "minLength": 1 },
    "artifact_role": { "const": "simulator_plan" },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_version": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "attempt_count": { "type": "integer", "minimum": 1 },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_index",
          "scenario_id",
          "session_id",
          "relative_path",
          "configuration_digest"
        ],
        "properties": {
          "attempt_index": { "type": "integer", "minimum": 1 },
          "scenario_id": { "type": "string" },
          "session_id": { "type": "string" },
          "relative_path": { "type": "string" },
          "configuration_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "expected_final_quality": { "type": "string" },
    "expected_final_action": { "type": "string" },
    "analysis_allowed": { "type": "boolean" },
    "expected_completion": { "type": "boolean" },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
